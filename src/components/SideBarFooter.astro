---
import { profile } from "../data/profile";
---

<div class="block sticky pointer-events-none bottom-10 bg-base-200 justify-center h-12 [mask-image:linear-gradient(transparent,#000000)]"></div>
<div class="social-icons px-4 pb-5 pt-1 flex flex-wrap gap-5 self-center justify-center sticky bottom-0 bg-base-200 text-sm">
  <a href={profile.github} target="_blank" rel="noopener noreferrer" class="link link-hover" aria-label="이유찬 GitHub">GitHub</a>
  <a href={profile.solvedAc} target="_blank" rel="noopener noreferrer" class="link link-hover">solved.ac</a>
  <a href={profile.leetcode} target="_blank" rel="noopener noreferrer" class="link link-hover">LeetCode</a>
  <a href="/rss.xml" class="link link-hover" aria-label="기술 기록 RSS">RSS</a>
</div>
