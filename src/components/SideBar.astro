---
import SideBarFooter from "./SideBarFooter.astro";
import { profile } from "../data/profile";
import SideBarMenu from "./SideBarMenu.astro";
const { sideBarActiveItemID } = Astro.props;
---

<div class="drawer-side z-40">
  <label for="my-drawer" class="drawer-overlay" aria-label="메뉴 닫기"></label>
  <aside class="px-2 pt-2 h-auto min-h-full w-[19rem] bg-base-200 text-base-content flex flex-col" aria-label="주 메뉴">
    <div class="w-fit mx-auto mt-5 mb-6">
      <a href="/" aria-label="이유찬 포트폴리오 홈">
        <div class="avatar transition ease-in-out hover:scale-[102%] block m-auto">
          <div class="w-[8.5rem] h-[8.5rem] mask mask-circle bg-base-300 flex items-center justify-center">
            <span class="text-4xl font-bold" aria-hidden="true">YC</span>
          </div>
        </div>
      </a>
      <div class="text-center mt-4"><p class="font-bold text-xl">{profile.name}</p><p class="text-sm opacity-70 mt-1">게임 클라이언트 개발자</p></div>
    </div>
    <SideBarMenu sideBarActiveItemID={sideBarActiveItemID} />
    <SideBarFooter />
  </aside>
</div>
