---
import { profile } from "../data/profile";
const { sideBarActiveItemID } = Astro.props;
const items = [
  { id: "home", label: "홈", href: "/" },
  { id: "projects", label: "프로젝트", href: "/projects/" },
  { id: "services", label: "역량과 기술", href: "/services/" },
  { id: "blog", label: "기술 기록", href: "/blog/" },
  { id: "cv", label: "이력", href: "/cv/" },
];
---

<ul class="menu grow shrink menu-md overflow-y-auto">
  {items.map((item) => <li><a class:list={["py-3 text-base", { "bg-base-300": sideBarActiveItemID === item.id }]}
    id={item.id} href={item.href} aria-current={sideBarActiveItemID === item.id ? "page" : undefined}>{item.label}</a></li>)}
  <li><a class="py-3 text-base" href={`mailto:${profile.email}`}>연락하기</a></li>
</ul>
