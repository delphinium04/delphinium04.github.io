---
import { profile } from "../data/profile";
const { sideBarActiveItemID } = Astro.props;
const items = [
  { id: "home", label: "홈", href: "/" },
  { id: "projects", label: "프로젝트", href: "/projects/" },
  { id: "services", label: "역량과 기술", href: "/services/" },
  { id: "blog", label: "기술 기록", href: "/blog/" },
  { id: "cv", label: "이력", href: "/cv/" },
];
---

<ul class="menu menu-sm p-0 gap-1">
  {items.map((item) => (
    <li>
      <a
        class:list={[
          "py-1.5 px-3 text-sm rounded-lg",
          { "bg-base-200 font-semibold": sideBarActiveItemID === item.id },
        ]}
        id={item.id}
        href={item.href}
        aria-current={sideBarActiveItemID === item.id ? "page" : undefined}
      >
        {item.label}
      </a>
    </li>
  ))}
  <li>
    <a class="py-1.5 px-3 text-sm rounded-lg" href={`mailto:${profile.email}`}>
      연락하기
    </a>
  </li>
</ul>
