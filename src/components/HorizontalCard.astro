---
const { title, img, imageWidth = 750, imageHeight = 422, icon, desc, url, badge, tags, target = "_blank" } = Astro.props;
import { Image } from "astro:assets";
---

<div
  class="rounded-lg bg-base-100 hover:shadow-xl transition ease-in-out hover:scale-[102%]"
>
  <a href={url} target={target} rel={target === "_blank" ? "noopener noreferrer" : undefined}>
    <div class="hero-content max-w-none w-full justify-start flex-col md:flex-row py-6 px-4 gap-6">
      {
        img && (
          <Image
            src={img}
            width={imageWidth}
            height={imageHeight}
            format="webp"
            alt={title}
            class="max-w-full md:max-w-[13rem] h-auto object-contain rounded-lg"
          />
        )
      }
      {!img && icon && <div class="w-full md:w-[13rem] shrink-0 aspect-video rounded-lg bg-base-200 flex items-center justify-center text-5xl" aria-hidden="true">{icon}</div>}
      <div class="grow w-full space-y-2.5">
        <div class="flex flex-wrap items-center gap-2">
          <h3 class="text-2xl md:text-3xl font-bold leading-snug mr-1">
            {title}
          </h3>
          {badge && <span class="badge badge-secondary">{badge}</span>}
          {tags && tags.map((tag) => (
            <span class="badge badge-outline">{tag}</span>
          ))}
        </div>
        <p class="py-1 text-base leading-relaxed text-base-content/80">{desc}</p>
      </div>
    </div>
  </a>
</div>
