---
const { title, img, imageWidth = 750, imageHeight = 422, icon, desc, url, badge, tags, target = "_blank" } = Astro.props;
import { Image } from "astro:assets";
const tag_url = url.split("/").slice(0, -1).join("/") + "/tag";
---

<div
  class="rounded-lg bg-base-100 hover:shadow-xl transition ease-in-out hover:scale-[102%]"
>
  <a href={url} target={target} rel={target === "_blank" ? "noopener noreferrer" : undefined}>
    <div class="hero-content flex-col md:flex-row gap-5 py-5 px-4 md:px-5">
      {
        img && (
          <Image
            src={img}
            width={imageWidth}
            height={imageHeight}
            format="webp"
            alt={title}
            class="max-w-full md:max-w-[13rem] h-auto object-contain rounded-lg"
          />
        )
      }
      {!img && icon && <div class="w-full md:w-[13rem] shrink-0 aspect-video rounded-lg bg-base-200 flex items-center justify-center text-5xl" aria-hidden="true">{icon}</div>}
      <div class="grow w-full">
        <h3 class="text-xl font-bold leading-snug flex flex-wrap items-center gap-2">
          <span>{title}</span>
          {badge && <span class="badge badge-secondary">{badge}</span>}
        </h3>
        <p class="mt-2.5 text-base leading-relaxed text-base-content/85">{desc}</p>
      </div>
    </div>
  </a>
  {tags && <div class="card-actions justify-end px-4 pb-4">{tags.map((tag) => (
    <a href={`${tag_url}/${encodeURIComponent(tag)}`} class="badge badge-outline">{tag}</a>
  ))}</div>}
</div>
