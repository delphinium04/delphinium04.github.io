---
const { title, subtitle } = Astro.props;
const hasSlot = Astro.slots.has("default");
---

<div class="flex">
  <div class="education__time">
    <span class="w-4 h-4 bg-primary block rounded-full mt-1.5"></span>
    <span class="education__line bg-primary block h-full w-[2px] translate-x-[7px]"></span>
  </div>
  <div class="experience__data bd-grid px-5 pb-7">
    <h3 class="font-semibold text-lg leading-snug mb-1.5">{title}</h3>
    <span class="font-light text-sm text-base-content/75 block">{subtitle}</span>
    {hasSlot && (
      <p class="mt-2.5 leading-relaxed text-base-content/85">
        <slot />
      </p>
    )}
  </div>
</div>
