---
import BaseLayout from "../layouts/BaseLayout.astro";
import TimeLineElement from "../components/cv/TimeLine.astro";
import ProfileLinks from "../components/ProfileLinks.astro";
import { profile } from "../data/profile";
---

<BaseLayout title="이력 | 이유찬 포트폴리오" description="게임 클라이언트 개발자 이유찬의 학력, 교육 및 활동, 자격과 경험입니다." sideBarActiveItemID="cv">
  <div class="mb-5">
    <h1 class="text-3xl w-full font-bold">이력</h1>
  </div>

  <div class="mb-10">
    <h2 class="text-xl font-bold mb-2">{profile.name} <span class="font-normal text-base opacity-70">{profile.englishName}</span></h2>
    <p class="font-semibold mb-3">{profile.role}</p>
    <p class="mb-3 leading-relaxed">{profile.tagline}</p>
    <p class="leading-relaxed">{profile.description}</p>
    <div class="mt-5" aria-label="프로필 링크">
      <ProfileLinks />
    </div>
  </div>

  <div class="mb-5">
    <h2 class="text-3xl w-full font-bold">학력</h2>
  </div>

  <div class="time-line-container grid gap-4 mb-10">
    <TimeLineElement title="상명대학교 서울캠퍼스 게임전공" subtitle="2023.03 ~ 2027.02">
      4년제 학사 졸업예정 · 한일문화콘텐츠전공 부전공
    </TimeLineElement>
    <TimeLineElement title="세명컴퓨터고등학교 게임콘텐츠과" subtitle="2021.09 ~ 2023.02" />
  </div>

  <div class="mb-5">
    <h2 class="text-3xl w-full font-bold">교육 및 활동</h2>
  </div>

  <div class="time-line-container grid gap-4 mb-10">
    <TimeLineElement title="XR 기술을 활용한 게임 개발자 부트캠프 4회차 참여" subtitle="2025.12 ~ 2026.04 · 주식회사 디벨로켓에듀(前 경일게임IT아카데미)">
      게임 개발 실습·팀 프로젝트·포트폴리오 제작을 경험했습니다. 취업 준비 방향을 재정비하며 중도 종료했습니다.
    </TimeLineElement>
    <TimeLineElement title="청년 일경험 지원사업 참여" subtitle="2025년 · (사)한국능률협회 · 주식회사 행복한 다람쥐단">
      3인 팀의 Unity 3D 편의점 시뮬레이션 개발에서 손님 행동과 상태를 FSM으로 구현했습니다.
    </TimeLineElement>
    <TimeLineElement title="2022 비버 게임잼 참여" subtitle="2022.12">
      제한된 시간의 팀 개발을 경험하며 자료구조·알고리즘 기본기의 중요성을 배운 계기가 되었습니다.
    </TimeLineElement>
  </div>

  <div class="mb-5">
    <h2 class="text-3xl w-full font-bold">자격 및 어학</h2>
  </div>

  <div class="time-line-container grid gap-4 mb-10">
    <TimeLineElement title="JLPT N5 합격" subtitle="2022.01" />
    <TimeLineElement title="ITQ 한글엑셀(한셀) A등급" subtitle="2016.03 · 한국생산성본부" />
    <TimeLineElement title="ITQ 아래한글 A등급" subtitle="2015.10 · 한국생산성본부" />
    <TimeLineElement title="ITQ 한글파워포인트(한쇼) A등급" subtitle="2014.10 · 한국생산성본부" />
  </div>

  <div class="mb-5">
    <h2 class="text-3xl w-full font-bold">기타 경험</h2>
  </div>

  <div class="time-line-container grid gap-4 mb-10">
    <TimeLineElement title="GS25 매장 근무 경험" subtitle="총 2년 이상">
      중계센트럴점·S상봉역점·사가정아이파크점 등에서 고객 응대와 매장 업무를 경험했습니다.
    </TimeLineElement>
  </div>

</BaseLayout>
