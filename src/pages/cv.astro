---
import BaseLayout from "../layouts/BaseLayout.astro";
import TimeLineElement from "../components/cv/TimeLine.astro";
import ProfileLinks from "../components/ProfileLinks.astro";
import { profile } from "../data/profile";
---

<BaseLayout title="이력 | 이유찬 포트폴리오" description="게임 클라이언트 개발자 이유찬의 학력, 교육 및 활동, 자격과 경험입니다." sideBarActiveItemID="cv">
  <div class="mb-6">
    <h1 class="text-3xl w-full font-bold">이력</h1>
  </div>

  <div class="mb-12">
    <h2 class="text-xl font-bold mb-2">{profile.name} <span class="font-normal text-base opacity-70">{profile.englishName}</span></h2>
    <p class="font-semibold mb-4 text-base-content/80">{profile.role}</p>
    <div class="space-y-3 leading-relaxed">
      <p>{profile.tagline}</p>
      <p class="text-base-content/85">{profile.description}</p>
    </div>
    <div class="mt-6" aria-label="프로필 링크">
      <ProfileLinks />
    </div>
  </div>

  <div class="mb-6">
    <h2 class="text-3xl w-full font-bold">학력</h2>
  </div>

  <div class="time-line-container grid mb-12">
    <TimeLineElement title="상명대학교 서울캠퍼스 게임전공" subtitle="2023.03 ~ 2027.02">
      4년제 학사 졸업예정 · 한일문화콘텐츠전공 부전공
    </TimeLineElement>
    <TimeLineElement title="세명컴퓨터고등학교 게임콘텐츠과" subtitle="2021.09 ~ 2023.02" />
  </div>

  <div class="mb-6">
    <h2 class="text-3xl w-full font-bold">교육 및 대외활동</h2>
  </div>

  <div class="time-line-container grid mb-12">
    <TimeLineElement title="XR 기술을 활용한 게임 개발자 부트캠프 4회차" subtitle="2025.12 ~ 2026.04 · 주식회사 디벨로켓에듀(前 경일게임IT아카데미)">
      실무형 실습과 13인 협업 프로젝트, 포트폴리오 제작을 진행했으며 이후 취업 준비 방향을 재정비하며 중도 종료했습니다.
    </TimeLineElement>
    <TimeLineElement title="청년 일경험 지원사업" subtitle="2025년 · (사)한국능률협회 · 주식회사 행복한 다람쥐단">
      3인 팀으로 진행한 Unity 3D 편의점 시뮬레이션 프로젝트에서 방문 손님의 단계별 행동 AI를 FSM으로 작성했습니다.
    </TimeLineElement>
    <TimeLineElement title="2022 비버 게임잼" subtitle="2022.12">
      짧은 호흡의 팀 개발에 도전하며, 제한된 시간 안에 의도한 로직을 완성하기 위한 자료구조·알고리즘 기초의 중요성을 체감했습니다.
    </TimeLineElement>
  </div>

  <div class="mb-6">
    <h2 class="text-3xl w-full font-bold">자격 및 어학</h2>
  </div>

  <div class="time-line-container grid mb-12">
    <TimeLineElement title="JLPT N5 합격" subtitle="2022.01" />
    <TimeLineElement title="ITQ 한글엑셀(한셀) A등급" subtitle="2016.03 · 한국생산성본부" />
    <TimeLineElement title="ITQ 아래한글 A등급" subtitle="2015.10 · 한국생산성본부" />
    <TimeLineElement title="ITQ 한글파워포인트(한쇼) A등급" subtitle="2014.10 · 한국생산성본부" />
  </div>

  <div class="mb-6">
    <h2 class="text-3xl w-full font-bold">기타 이력</h2>
  </div>

  <div class="time-line-container grid mb-12">
    <TimeLineElement title="GS25 매장 근무" subtitle="총 2년 이상">
      중계센트럴점·S상봉역점·사가정아이파크점 등에서 근무하며 매장 운영과 고객 응대를 맡았습니다.
    </TimeLineElement>
  </div>

</BaseLayout>
