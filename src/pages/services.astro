---
import BaseLayout from "../layouts/BaseLayout.astro";
import { profile, strengths, skills } from "../data/profile";

const usedSkills = skills.filter((skill) => skill.category !== "학습 중" && skill.name !== "C++");
const skillCategories = [...new Set(usedSkills.map((skill) => skill.category))];
const learningSkills = skills.filter((skill) => skill.category === "학습 중" || skill.name === "C++");
---

<BaseLayout title="역량 | 이유찬 포트폴리오" description="게임플레이와 상태 설계, 공통 시스템과 UI, 모듈 통합 및 협업 경험과 현재 학습 중인 기술을 소개합니다." sideBarActiveItemID="services">
  <div class="mb-5">
    <h1 class="text-3xl w-full font-bold">역량</h1>
  </div>
  <p class="mb-10 leading-relaxed">{profile.description}</p>

  <h2 class="text-3xl w-full font-bold mb-5">핵심 역량</h2>
  <div class="mb-10">
    {strengths.map((strength, index) => (
      <>
        <article class="rounded-lg bg-base-100">
          <div class="hero-content items-start justify-start p-4">
            <div class="grow w-full">
              <h3 class="text-xl font-bold">{strength.title}</h3>
              <p class="py-2 leading-relaxed">{strength.description}</p>
            </div>
          </div>
        </article>
        {index < strengths.length - 1 && <div class="divider my-0"></div>}
      </>
    ))}
  </div>

  <h2 class="text-3xl w-full font-bold mb-5">기술 활용 경험</h2>
  <div class="grid md:grid-cols-2 gap-4 mb-10">
    {skillCategories.map((category) => (
      <article class="rounded-lg bg-base-100 border border-base-200 p-5">
        <h3 class="text-xl font-bold mb-4">{category}</h3>
        <ul class="grid gap-4">
          {usedSkills.filter((skill) => skill.category === category).map((skill) => (
            <li>
              <h4 class="font-semibold mb-1">{skill.name}</h4>
              <p class="text-sm leading-relaxed">{skill.description}</p>
            </li>
          ))}
        </ul>
      </article>
    ))}
  </div>

  <h2 class="text-3xl w-full font-bold mb-5">현재 학습</h2>
  <div class="grid gap-4 mb-5">
    {learningSkills.map((skill) => (
      <article class="rounded-lg bg-base-100 border border-base-200 p-5">
        <h3 class="text-xl font-bold mb-2">{skill.name}</h3>
        <p class="leading-relaxed">{skill.description}</p>
      </article>
    ))}
  </div>
  <div class="flex flex-wrap gap-3 mb-10">
    <a class="btn btn-outline btn-sm" href={profile.solvedAc} target="_blank" rel="noopener noreferrer">solved.ac</a>
    <a class="btn btn-outline btn-sm" href={profile.leetcode} target="_blank" rel="noopener noreferrer">LeetCode</a>
  </div>

  <h2 class="text-3xl w-full font-bold mb-5">개발자로서 중요하게 생각하는 것</h2>
  <div class="grid gap-5">
    <article>
      <h3 class="text-xl font-bold mb-2">플레이어가 즐길 수 있는 결과물</h3>
      <p class="leading-relaxed">사람들이 즐기는 문화 콘텐츠를 만드는 일에 기여하고 싶습니다. 대학 프로젝트를 PlayX4에 선보이며, 기획 의도와 복잡한 규칙을 안정적으로 구현하는 일이 실제 플레이 경험으로 이어지는 보람을 느꼈습니다.</p>
    </article>
    <article>
      <h3 class="text-xl font-bold mb-2">함께 원인을 이해하는 문제 해결</h3>
      <p class="leading-relaxed">팀원이 막혔을 때 입력 흐름과 컴포넌트의 역할을 함께 정리하고, 브레이크포인트로 기대한 동작과 달라지는 지점을 확인합니다. 동료가 자신의 코드 구조를 이해하고 직접 해결할 수 있도록 돕습니다.</p>
    </article>
    <article>
      <h3 class="text-xl font-bold mb-2">꾸준히 다지는 기본기</h3>
      <p class="leading-relaxed">현재는 C++로 자료구조와 알고리즘을 직접 구현하고 문제를 풀며 기본기를 다지고 있습니다. 그래픽 렌더링 과정과 운영체제도 함께 학습하고 있습니다.</p>
    </article>
  </div>
</BaseLayout>
