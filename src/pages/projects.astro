---
import BaseLayout from "../layouts/BaseLayout.astro";
import HorizontalCard from "../components/HorizontalCard.astro";
import { getCollection } from "astro:content";
import { projectIcons } from "../data/project-icons";

const projects = (await getCollection("projects")).sort((a, b) => a.data.order - b.data.order);
const groups = [
  { title: "Unity 프로젝트", projects: projects.filter((project) => project.data.stack.includes("Unity")) },
  { title: "기본기를 쌓은 프로젝트", projects: projects.filter((project) => !project.data.stack.includes("Unity")) },
];
---

<BaseLayout title="프로젝트 | 이유찬" sideBarActiveItemID="projects">
  <h1 class="text-3xl font-bold mb-4">프로젝트</h1>
  <p class="mb-10 text-lg leading-relaxed text-base-content/85">캐릭터 조작과 전투 시스템부터 UI 프레임워크, 프로세스 간 통신까지 직접 설계하고 부딪치며 완성한 작업물입니다.</p>
  {groups.map((group) => (
    <section class="mb-14">
      <h2 class="text-2xl font-bold mb-5">{group.title}</h2>
      {group.projects.map((project) => (
        <>
          <HorizontalCard title={project.data.title} img={project.data.heroImage} icon={projectIcons[project.slug]}
            imageWidth={project.data.imageWidth} imageHeight={project.data.imageHeight}
            desc={`${project.data.period} · ${project.data.description}`} url={`/projects/${project.slug}/`}
            target="_self" badge={project.data.badge} />
          <div class="divider my-1"></div>
        </>
      ))}
    </section>
  ))}
</BaseLayout>
