---
import BaseLayout from "../layouts/BaseLayout.astro";
import HorizontalCard from "../components/HorizontalCard.astro";
import { getCollection } from "astro:content";
import { profile, strengths } from "../data/profile";
import { projectIcons } from "../data/project-icons";
import createSlug from "../lib/createSlug";

const projects = (await getCollection("projects")).sort((a, b) => a.data.order - b.data.order);
const posts = ((await getCollection("blog")) ?? []).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()).slice(0, 3);
---

<BaseLayout sideBarActiveItemID="home">
  <!-- 1. 맨 위 화면 너비를 꽉 채우는 대표 배경 이미지 -->
  <div slot="cover" class="w-full h-64 md:h-96 overflow-hidden bg-base-200 border-b border-base-300">
    <img
      src={profile.coverImage}
      alt="이유찬 대표 배경 사진"
      class="w-full h-full object-cover object-[center_40%]"
    />
  </div>

  <div class="space-y-24 pb-16">
    <!-- 상단 프로필 및 소개 영역 -->
    <section class="space-y-10">
      <!-- 2. 프로필 이미지 + 오른쪽에 첫 제목 및 부제목 -->
      <div class="flex flex-col sm:flex-row sm:items-center gap-6 md:gap-8">
        <div class="w-28 md:w-32 shrink-0 rounded-2xl overflow-hidden bg-base-200 border border-base-300 shadow-sm">
          <img
            src={profile.photo}
            alt={`${profile.name} 프로필 사진`}
            class="w-full h-auto block"
          />
        </div>

        <div class="space-y-2.5">
          <h1 class="text-3xl md:text-4xl font-bold leading-tight tracking-tight">
            안녕하세요, 이유찬입니다.
          </h1>
          <p class="text-xl md:text-2xl font-semibold text-base-content/75">
            {profile.role}
          </p>
        </div>
      </div>

      <!-- 3. 소개 본문 텍스트 영역 -->
      <div class="space-y-4 text-lg leading-relaxed pt-2">
        <p class="font-semibold">{profile.tagline}</p>
        <p class="text-base-content/80">{profile.description}</p>
        <p class="pt-3 font-semibold tracking-wide text-base-content/90">
          Unity · C# · C++
        </p>
      </div>
    </section>

    <!-- 주요 프로젝트 영역 -->
    <section aria-labelledby="projects-heading" class="space-y-8">
      <div class="flex flex-wrap items-baseline justify-between gap-3">
        <h2 id="projects-heading" class="text-3xl font-bold">주요 프로젝트 {"</>"}</h2>
        <a class="link link-hover text-sm" href="/projects/">전체 프로젝트 →</a>
      </div>
      <div class="space-y-4">
        {projects.map((project, index) => (
          <>
            <HorizontalCard
              title={project.data.title}
              img={project.data.heroImage}
              icon={projectIcons[project.slug]}
              imageWidth={project.data.imageWidth}
              imageHeight={project.data.imageHeight}
              desc={project.data.description}
              url={`/projects/${project.slug}/`}
              target="_self"
              badge={project.data.badge}
            />
            {index < projects.length - 1 && <div class="divider my-2"></div>}
          </>
        ))}
      </div>
    </section>

    <!-- 개발에서 집중하는 것 영역 -->
    <section aria-labelledby="strengths-heading" class="space-y-8">
      <h2 id="strengths-heading" class="text-3xl font-bold">개발에서 집중하는 것</h2>
      <div class="grid gap-8 md:grid-cols-2">
        {strengths.slice(0, 4).map((strength) => (
          <div class="space-y-2">
            <h3 class="font-bold text-lg">{strength.title}</h3>
            <p class="leading-relaxed text-base-content/80">{strength.description}</p>
          </div>
        ))}
      </div>
      <div class="pt-2">
        <a class="link link-hover text-sm" href="/services/">역량과 기술 자세히 보기 →</a>
      </div>
    </section>

    <!-- 최근 기술 기록 영역 -->
    <section aria-labelledby="blog-heading" class="space-y-8">
      <h2 id="blog-heading" class="text-3xl font-bold">최근 기술 기록</h2>
      {posts.length > 0 ? (
        <div class="space-y-4">
          {posts.map((post, index) => (
            <>
              <HorizontalCard
                title={post.data.title}
                img={post.data.heroImage}
                desc={post.data.description}
                url={`/blog/${createSlug(post.data.title, post.slug)}/`}
                target="_self"
                badge={post.data.badge}
              />
              {index < posts.length - 1 && <div class="divider my-2"></div>}
            </>
          ))}
        </div>
      ) : (
        <div class="bg-base-200 border-l-4 border-secondary p-6 rounded-r-lg space-y-3">
          <p class="leading-relaxed">기술 기록을 준비하고 있습니다. 프로젝트별 구현 과정과 회고는 프로젝트 상세에서 읽을 수 있습니다.</p>
          <a class="link link-hover inline-block" href="/projects/">프로젝트 구현 과정 읽기 →</a>
        </div>
      )}
    </section>

    <!-- 연락 영역 -->
    <section id="contact" aria-labelledby="contact-heading" class="space-y-6">
      <h2 id="contact-heading" class="text-3xl font-bold">연락</h2>
      <div class="space-y-3">
        <p>{profile.location}</p>
        <a class="link link-hover inline-block break-all" href={`mailto:${profile.email}`}>
          {profile.email}
        </a>
      </div>
      <div class="flex flex-wrap gap-6 pt-2">
        <a class="link link-hover" href={profile.github} target="_blank" rel="noopener noreferrer">GitHub ↗</a>
        <a class="link link-hover" href={profile.solvedAc} target="_blank" rel="noopener noreferrer">solved.ac ↗</a>
        <a class="link link-hover" href={profile.leetcode} target="_blank" rel="noopener noreferrer">LeetCode ↗</a>
      </div>
    </section>
  </div>
</BaseLayout>
