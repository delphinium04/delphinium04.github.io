---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { projectIcons } from "../../data/project-icons";

export async function getStaticPaths() {
  return (await getCollection("projects")).map((project) => ({ params: { slug: project.slug }, props: { project } }));
}
const { project } = Astro.props;
const { Content } = await project.render();
const { title, description, period, team, role, stack, heroImage, badge, links } = project.data;
---

<BaseLayout title={`${title} | 이유찬`} description={description} image={heroImage} sideBarActiveItemID="projects" ogType="article">
  <a class="link link-hover text-sm" href="/projects/">← 전체 프로젝트</a>
  <article class="mt-6 max-w-[750px]">
    <header>
      <div class="flex flex-wrap items-center gap-3">
        <h1 class="text-4xl font-bold leading-tight"><span aria-hidden="true">{projectIcons[project.slug]} </span>{title}</h1>
        {badge && <span class="badge badge-secondary">{badge}</span>}
      </div>
      <p class="text-lg leading-relaxed mt-4">{description}</p>
      <dl class="grid gap-4 sm:grid-cols-2 bg-base-200 rounded-lg p-5 my-6">
        <div><dt class="text-sm opacity-70">개발 기간</dt><dd class="mt-1">{period}</dd></div>
        <div><dt class="text-sm opacity-70">팀 구성</dt><dd class="mt-1">{team}</dd></div>
        <div class="sm:col-span-2"><dt class="text-sm opacity-70">담당 역할</dt><dd class="mt-1">{role}</dd></div>
      </dl>
      <div class="flex flex-wrap gap-2 mb-6">{stack.map((tech) => <span class="badge badge-outline">{tech}</span>)}</div>
      {links.length > 0 && <div class="flex flex-wrap gap-3 mb-8">{links.map((link) => (
        <a class="btn btn-outline btn-sm" href={link.url} target="_blank" rel="noopener noreferrer">{link.label} ↗</a>
      ))}</div>}
      {heroImage && <Image src={heroImage} alt={`${title} 게임 화면`} width={750} height={422} class="w-full rounded-lg mb-8" />}
    </header>
    <div class="prose prose-lg max-w-none prose-headings:scroll-mt-20 prose-pre:max-w-full prose-pre:overflow-x-auto">
      <Content />
    </div>
    <div class="divider mt-10"></div>
    <a class="btn btn-outline" href="/projects/">다른 프로젝트 보기</a>
  </article>
</BaseLayout>
