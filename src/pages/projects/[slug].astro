---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { projectIcons } from "../../data/project-icons";

export async function getStaticPaths() {
  return (await getCollection("projects")).map((project) => ({ params: { slug: project.slug }, props: { project } }));
}
const { project } = Astro.props;
const { Content, headings } = await project.render();
const tocHeadings = headings.filter((h) => h.depth === 2 || h.depth === 3);
const { title, description, period, team, role, roleLabel, stack, heroImage, imageWidth, imageHeight, badge, steamAppId, links, videos } = project.data;
// 커버 이미지: 원본 너비 유지, 세로는 최대 400px (초과 시 중앙 크롭)
const COVER_MAX_HEIGHT = 400;
const coverWidth = imageWidth ?? 1024;
const coverHeight = Math.min(imageHeight ?? COVER_MAX_HEIGHT, COVER_MAX_HEIGHT);
---

<BaseLayout
  title={`${title} | 이유찬`}
  description={description}
  image={heroImage}
  sideBarActiveItemID="projects"
  tocHeadings={tocHeadings}
  backHref="/#projects"
  ogType="article"
>
  {heroImage && <div slot="cover" class="project-cover w-full flex justify-center bg-base-200 border-b border-base-300">
    <img
      src={heroImage}
      alt={`${title} 커버 이미지`}
      width={coverWidth}
      height={coverHeight}
      style={`width:${coverWidth}px;aspect-ratio:${coverWidth}/${coverHeight}`}
      class="block max-w-full h-auto object-cover object-center"
    />
  </div>}
  <a class="link link-hover text-sm" href="/#projects">← 홈으로 돌아가기</a>
  <article class="mt-6 w-full">
    <header>
      <div class="flex flex-wrap items-center gap-3">
        <h1 class="text-4xl font-bold leading-tight"><span aria-hidden="true">{projectIcons[project.slug]} </span>{title}</h1>
        {badge && <span class="badge badge-secondary">{badge}</span>}
      </div>
      <p class="text-lg leading-relaxed mt-5 text-base-content/90">{description}</p>
      <dl class="grid gap-5 sm:grid-cols-2 bg-base-200 rounded-lg p-6 my-7">
        <div><dt class="text-sm opacity-70">개발 기간</dt><dd class="mt-1.5 leading-relaxed">{period}</dd></div>
        <div><dt class="text-sm opacity-70">팀 구성</dt><dd class="mt-1.5 leading-relaxed">{team}</dd></div>
        <div class="sm:col-span-2"><dt class="text-sm opacity-70">{roleLabel}</dt><dd class="mt-1.5 leading-relaxed">{role}</dd></div>
      </dl>
      <div class="flex flex-wrap gap-2 mb-6">{stack.map((tech) => <span class="badge badge-outline">{tech}</span>)}</div>
      {links.length > 0 && <div class="flex flex-wrap gap-3 mb-8">{links.map((link) => (
        <a class="btn btn-outline btn-sm" href={link.url} target="_blank" rel="noopener noreferrer">{link.label} ↗</a>
      ))}</div>}
    </header>
    {steamAppId && <section class="mb-10" aria-labelledby="project-steam-heading">
      <h2 id="project-steam-heading" class="text-2xl font-bold mb-4">Steam 상점 페이지</h2>
      <div class="flex justify-center">
        <iframe
          class="w-full max-w-[646px] h-[190px] border-0 rounded-lg"
          src={`https://store.steampowered.com/widget/${steamAppId}/`}
          title={`${title} Steam 상점 위젯`}
          loading="lazy"
        ></iframe>
      </div>
    </section>}
    {videos.length > 0 && <section class="mb-10" aria-labelledby="project-videos-heading">
      <h2 id="project-videos-heading" class="text-2xl font-bold mb-4">플레이 영상</h2>
      <div class="grid gap-6">
        {videos.map((video) => <figure>
          {video.type === "youtube" ? (
            video.unavailableReason ? (
              <div class="rounded-lg bg-base-200 p-5 leading-relaxed">
                <p>{video.unavailableReason}</p>
                <a class="link link-hover mt-3 inline-block" href={`https://www.youtube.com/watch?v=${video.id}`} target="_blank" rel="noopener noreferrer">원본 YouTube 링크 ↗</a>
              </div>
            ) : (
              <div class="relative aspect-video overflow-hidden rounded-lg bg-base-200">
                <iframe
                  class="absolute inset-0 h-full w-full border-0"
                  src={`https://www.youtube-nocookie.com/embed/${video.id}`}
                  title={video.title}
                  loading="lazy"
                  allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                  referrerpolicy="strict-origin-when-cross-origin"
                  allowfullscreen
                ></iframe>
              </div>
            )
          ) : (
            <video class="w-full rounded-lg bg-base-200" controls preload="metadata" poster={video.poster} aria-label={video.title}>
              <source src={video.src} type="video/mp4" />
              <p>영상을 재생할 수 없는 경우 <a class="link" href={video.src}>영상 파일을 열어주세요.</a></p>
            </video>
          )}
          <figcaption class="mt-2.5 text-sm opacity-70">{video.title}</figcaption>
        </figure>)}
      </div>
    </section>}
    <div class="prose prose-lg max-w-none prose-headings:scroll-mt-20 prose-pre:max-w-full prose-pre:overflow-x-auto">
      <Content />
    </div>
    <div class="divider mt-12"></div>
    <a class="btn btn-outline" href="/#projects">홈으로 돌아가기</a>
  </article>
</BaseLayout>

<script>
  // 커버 이미지 좌우 여백을 이미지의 맨 왼쪽 / 맨 오른쪽 열 평균 색으로 채움
  function edgeColor(img: HTMLImageElement, x: number, top: number, height: number) {
    const canvas = document.createElement("canvas");
    canvas.width = 1;
    canvas.height = height;
    const ctx = canvas.getContext("2d", { willReadFrequently: true });
    if (!ctx) return null;
    ctx.drawImage(img, x, top, 1, height, 0, 0, 1, height);
    const data = ctx.getImageData(0, 0, 1, height).data;
    let r = 0, g = 0, b = 0;
    for (let i = 0; i < data.length; i += 4) {
      r += data[i];
      g += data[i + 1];
      b += data[i + 2];
    }
    return `rgb(${Math.round(r / height)}, ${Math.round(g / height)}, ${Math.round(b / height)})`;
  }

  function paintCover(img: HTMLImageElement) {
    const cover = img.parentElement;
    const { naturalWidth: w, naturalHeight: h } = img;
    if (!cover || !w || !h) return;
    // 화면에 보이는(중앙 크롭된) 세로 구간만 샘플링
    const visibleHeight = Math.min(h, Math.round((w * img.height) / img.width) || h);
    const top = Math.floor((h - visibleHeight) / 2);
    try {
      const left = edgeColor(img, 0, top, visibleHeight);
      const right = edgeColor(img, w - 1, top, visibleHeight);
      if (left && right) cover.style.background = `linear-gradient(to right, ${left} 50%, ${right} 50%)`;
    } catch {
      // 캔버스 읽기 실패 시 기본 배경 유지
    }
  }

  function initCover() {
    const img = document.querySelector<HTMLImageElement>(".project-cover img");
    if (!img) return;
    if (img.complete) paintCover(img);
    else img.addEventListener("load", () => paintCover(img), { once: true });
  }

  document.addEventListener("astro:page-load", initCover);
</script>
